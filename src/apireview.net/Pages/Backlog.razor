@page "/"
@page "/backlog"

<div class="input-group mb-3">
    <div class="input-group-prepend">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">@SelectedGroup.DisplayName</button>
        <div class="dropdown-menu">
            @foreach (RepositoryGroup rg in RepositoryGroupService.RepositoryGroups)
            {
                <a class="dropdown-item" href="/?g=@Uri.EscapeDataString(rg.Name)">@rg.DisplayName</a>
            }
        </div>
    </div>
    <form method="get" action="/" class="flex-grow-1 d-flex">
        @if (SelectedGroup != RepositoryGroupService.Default)
        {
            <input type="hidden" name="g" value="@SelectedGroup.Name" />
        }
        <input type="hidden" name="m_submitted" value="1" />
        @foreach ((string k, bool v) in _milestones.Where(m => m.Value))
        {
            <input type="hidden" name="m" value="@k" />
        }
        <input class="form-control" type="text" name="q" placeholder="Filter" value="@Filter" />
    </form>
</div>

<div class="gh-issue-header">
    <div class="row no-gutters">

        <div class="col-auto align-self-center">
            <input class="ml-2 mr-3" type="checkbox" id="select-all-issues" />
        </div>

        <div class="col align-self-center">
            <p class="text-muted m-0" id="issue-count-display">
                @{
                    int numberOfOrgs = Issues.Select(i => i.Owner).Distinct().Count();
                    int numberOfRepos = Issues.Select(i => i.Repo).Distinct().Count();
                    int visibleIssues = VisibleIssues.Count(IsVisible);
                }

                @if (visibleIssues == Issues.Count)
                {
                    <text>
                        @Issues.Count issues across @numberOfOrgs orgs and @numberOfRepos repos
                    </text>
                }
                else
                {
                    <text>
                        @visibleIssues of @Issues.Count issues across @numberOfOrgs orgs and @numberOfRepos repos
                    </text>
                }
            </p>
            <div class="dropdown" id="selection-controls" style="display:none">
                <button class="btn btn-secondary btn-sm" type="button" id="copy-links-btn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span id="selection-count">0</span> items selected...
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    <a class="dropdown-item" href="#" id="copy-links-action">Copy links</a>
                </div>
            </div>
        </div>
        <div class="col">
            @if (_milestones is not null)
            {
                <div class="mr-2 float-right">
                    <div class="dropdown">
                        <button class="btn btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Milestones
                        </button>
                        <form method="get" action="/" class="dropdown-menu dropdown-menu-right p-2" id="milestone-form" aria-labelledby="dropdownMenuButton">
                            <input type="hidden" name="m_submitted" value="1" />
                            <input type="hidden" name="milestones_open" value="1" />
                            @if (SelectedGroup != RepositoryGroupService.Default)
                            {
                                <input type="hidden" name="g" value="@SelectedGroup.Name" />
                            }
                            @if (!string.IsNullOrEmpty(Filter))
                            {
                                <input type="hidden" name="q" value="@Filter" />
                            }

                            <a class="dropdown-item" href="@SelectAllMilestonesUrl">Select All</a>
                            <a class="dropdown-item" href="@SelectNoneMilestonesUrl">Select None</a>
                            <div class="dropdown-divider"></div>

                            @foreach ((string k, bool v) in _milestones)
                            {
                                <div class="m-2 checkbox">
                                    <label><input class="mr-2" type="checkbox" name="m" value="@k" checked="@(v ? "checked" : null)" onchange="this.form.submit()">@k</label>
                                </div>
                            }
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<div class="gh-issue-list">

    @foreach (ApiReviewIssue issue in Issues)
    {
        if (!IsVisible(issue))
            continue;

        string background = issue.IsBlocking ? "gh-issue-blocking" : "";

        <div class="gh-issue-cell @background text-break"
             data-issue-url="@issue.Url"
             data-issue-id="@issue.IdFull"
             data-issue-title="@issue.Title">
            <div class="d-flex flex-row align-items-center">
                <div class="align-self-center">
                    <input class="ml-2 mr-3 issue-checkbox" type="checkbox" />
                </div>
                <div>
                    <a class="gh-issue-title" href="@issue.Url">@issue.Title.HighlightCode()</a>
                    <span>
                        @foreach (ApiReviewLabel label in issue.Labels)
                        {
                            <span class="gh-label"
                                  style="@label.GetStyle()"
                                  title="@label.Description">@label.Name.ExpandEmojis()</span>
                        }
                    </span>
                    <div class="gh-details-cell">
                        @issue.DetailText

                        @if (issue.Milestone is not null)
                        {
                            <span class="ml-2 mr-1 oi oi-signpost text-muted" aria-hidden="true"></span>@issue.Milestone
                        }

                        @{
                            int rank = GetRank(issue);
                            if (rank >= 0)
                            {
                                <span class="ml-2 mr-1 oi oi-elevator text-muted" aria-hidden="true" title="Backlog Rank"></span>@rank
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<AuthorizeView Roles="@ApiReviewConstants.ApiApproverRole">
    <div class="form-group row">
        <div class="col-sm-10">
            <form method="post" action="/admin/force-refresh">
                <AntiforgeryToken />
                <button class="btn btn-secondary" type="submit">Force Refresh</button>
            </form>
        </div>
    </div>
</AuthorizeView>

<script>
    (function () {
        var selectAll = document.getElementById('select-all-issues');
        var countDisplay = document.getElementById('issue-count-display');
        var selectionControls = document.getElementById('selection-controls');
        var selectionCount = document.getElementById('selection-count');
        var copyAction = document.getElementById('copy-links-action');

        function getChecked() {
            return document.querySelectorAll('.issue-checkbox:checked');
        }

        function updateSelectionUI() {
            var checked = getChecked();
            var total = document.querySelectorAll('.issue-checkbox');
            var n = checked.length;
            if (n === 0) {
                countDisplay.style.display = '';
                selectionControls.style.display = 'none';
                selectAll.checked = false;
                selectAll.indeterminate = false;
            } else {
                countDisplay.style.display = 'none';
                selectionControls.style.display = '';
                selectionCount.textContent = n;
                selectAll.checked = n === total.length;
                selectAll.indeterminate = n > 0 && n < total.length;
            }
        }

        document.addEventListener('change', function (e) {
            if (e.target === selectAll) {
                document.querySelectorAll('.issue-checkbox').forEach(function (cb) {
                    cb.checked = selectAll.checked;
                });
                updateSelectionUI();
            } else if (e.target.classList.contains('issue-checkbox')) {
                updateSelectionUI();
            }
        });

        // Re-open milestone dropdown if the form was just submitted
        var params = new URLSearchParams(window.location.search);
        if (params.get('milestones_open') === '1') {
            params.delete('milestones_open');
            var newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
            history.replaceState(null, '', newUrl);
            var btn = document.getElementById('dropdownMenuButton');
            if (btn) {
                var container = btn.closest('.dropdown');
                var menu = document.getElementById('milestone-form');
                if (container && menu) {
                    container.classList.add('show');
                    menu.classList.add('show');
                    btn.setAttribute('aria-expanded', 'true');
                }
            }
        }

        if (copyAction) {
            copyAction.addEventListener('click', function (e) {
                e.preventDefault();
                var lines = [];
                getChecked().forEach(function (cb) {
                    var cell = cb.closest('[data-issue-url]');
                    if (cell) {
                        var id = cell.getAttribute('data-issue-id');
                        var url = cell.getAttribute('data-issue-url');
                        var title = cell.getAttribute('data-issue-title');
                        lines.push('* [' + id + '](' + url + '): ' + title);
                    }
                });
                var text = lines.join('\n');
                navigator.clipboard.writeText(text);
                document.querySelectorAll('.issue-checkbox').forEach(function (cb) { cb.checked = false; });
                updateSelectionUI();
            });
        }
    })();
</script>
